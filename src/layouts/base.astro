---
import "../styles/global.css";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getLang, useTranslations, locales } from "../i18n/ui";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

interface Props {
  greeting: string;
}

const greeting = t("greeting");
const { greeting: propGreeting } = Astro.props;

const segments = Astro.url.pathname.split("/").filter(Boolean);
if (segments[0] === lang) segments.shift();
const path = segments.join("/");

const home = getRelativeLocaleUrl(lang, "/");
const links = [
  { href: `${home}#about`, label: t("nav.about") },
  { href: `${home}#projects`, label: t("nav.projects") },
  { href: `${home}#skills`, label: t("nav.skills") },
  { href: `${home}#experiences`, label: t("nav.experience") },
  { href: `${home}#studies`, label: t("nav.studies") },
  { href: `${home}#contact`, label: t("nav.contact") },
];
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{propGreeting}</title>

    <script is:inline>
      // Applies theme before displaying the page so there is no flash of incorrect theme
      try {
        const saved = localStorage.getItem("theme");
        const systemDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;
        document.documentElement.classList.toggle(
          "dark",
          saved ? saved === "dark" : systemDark,
        );
      } catch {}
    </script>
  </head>
  <body
    class="min-h-dvh bg-white font-sans text-neutral-900 antialiased transition-colors duration-300 motion-reduce:transition-none dark:bg-neutral-950 dark:text-neutral-100"
  >
    <header
      class="sticky top-0 z-50 border-b border-primary/10 bg-white/70 backdrop-blur-xl dark:border-primary/20 dark:bg-neutral-950/70"
    >
      <nav
        class="mx-auto flex max-w-5xl items-center justify-between gap-6 px-6 py-4"
        aria-label={t("nav.label")}
      >
        <a href={home} class="font-semibold tracking-tight text-primary-strong dark:text-primary"
          >{t("portfolio.title")}</a
        >

        <div class="flex items-center gap-4">
          <ul class="hidden gap-6 text-sm sm:flex">
            {
              links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="opacity-70 transition hover:opacity-100 hover:text-primary-strong dark:hover:text-primary"
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>

          {
            /* Choix de la langue : renvoie vers la même page dans l'autre langue */
          }
          <ul
            class="flex rounded-full bg-primary/10 p-1 text-xs font-medium dark:bg-primary/15"
          >
            {
              Object.entries(locales).map(([code, label]) => (
                <li>
                  <a
                    href={getRelativeLocaleUrl(code, path)}
                    hreflang={code}
                    lang={code}
                    aria-label={label}
                    aria-current={code === lang ? "true" : undefined}
                    class:list={[
                      "block rounded-full px-2.5 py-1 transition",
                      code === lang
                        ? "bg-primary-strong text-white shadow-sm"
                        : "opacity-60 hover:opacity-100",
                    ]}
                  >
                    {code.toUpperCase()}
                  </a>
                </li>
              ))
            }
          </ul>

          {/* Bouton thème : la lune s'affiche en clair, le soleil en sombre */}
          <button
            id="theme-toggle"
            type="button"
            aria-label={t("theme.toggle")}
            class="rounded-full p-2 text-primary transition hover:bg-primary/10 active:scale-95 dark:hover:bg-primary/15"
          >
            <svg
              class="size-5 dark:hidden"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
            <svg
              class="hidden size-5 dark:block"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="5"></circle>
              <path
                d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"
              ></path>
            </svg>
          </button>
        </div>
      </nav>
    </header>
    <main id="content" class="mx-auto max-w-5xl px-6 py-16">
      <slot>
        {t("error.no-content")}
      </slot>
    </main>
    <footer class="border-t border-primary/10 dark:border-primary/20">
			<p class="mx-auto max-w-5xl px-6 py-8 text-sm opacity-60">© {new Date().getFullYear()} - Mounir BEKHDADI</p>
		</footer>

    <script>
      // Applies selected theme and saves it on the browser
      document.querySelector("#theme-toggle")?.addEventListener("click", () => {
        const isDark = document.documentElement.classList.toggle("dark");
        try {
          localStorage.setItem("theme", isDark ? "dark" : "light");
        } catch {}
      });
    </script>
  </body>
</html>
